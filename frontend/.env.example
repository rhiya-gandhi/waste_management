# WasteRoute Frontend Environment Variables
# Copy this file to .env and provide your actual Supabase and AI service endpoints

# Supabase Public Configuration (Safe for client-side code)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Python FastAPI Waste AI Service Endpoint
VITE_AI_SERVICE_URL=http://localhost:8000

# Tile Provider Configuration (OpenStreetMap tile server)
VITE_OSM_TILE_LAYER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
